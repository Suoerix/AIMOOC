# https://platform.openai.com/account/api-keys
# 服务端使用，AI 总结 / 笔记 / 聊天均通过 Next.js API Routes 调用
OPENAI_API_KEY=sk-xxx

# 可选：自定义 OpenAI 兼容网关（如 one-api、azure 代理等）
OPENAI_BASE_URL=
# 可选：模型名，默认 gpt-4o-mini
OPENAI_MODEL=

# https://www.bilibili.com
# 可选：B站登录凭证（SESSDATA 或完整 Cookie）
# 推荐在页面右上角「B站」入口扫码登录，凭证仅保存在浏览器本地
# 此环境变量仅作为未在页面登录时的服务端兜底
BILIBILI_SESSION_TOKEN=

# https://savesubs.com
SAVESUBS_X_AUTH_TOKEN=

# https://upstash.com
# 可选：Redis 缓存（AI 总结结果缓存）；缺失时自动跳过缓存
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 限流用的 Redis（可与上面相同）
UPSTASH_RATE_REDIS_REST_URL=${UPSTASH_REDIS_REST_URL}
UPSTASH_RATE_REDIS_REST_TOKEN=${UPSTASH_REDIS_REST_TOKEN}

# https://supabase.com/docs/reference/javascript/initializing
SUPABASE_HOSTNAME=xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://${SUPABASE_HOSTNAME}


############ Optional #################

# https://docs.sentry.io/product/cli/configuration
SENTRY_AUTH_TOKEN=

# https://www.segment.com
NEXT_PUBLIC_SEGMENT_WRITEKEY=

NEXT_PUBLIC_SITE_URL=
